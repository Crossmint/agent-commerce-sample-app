# Copy to apps/web/.env.local for development. Never commit real values.

# --- Crossmint ---------------------------------------------------------------
# "staging" or "production". Staging keys start with ck_staging_ / sk_staging_.
CROSSMINT_ENV=staging
# Client API key. The server forwards it with the user's JWT on every order-intent call.
CROSSMINT_CLIENT_API_KEY=ck_staging_...
# Same client key, exposed to the browser for the save-card and verification components.
NEXT_PUBLIC_CROSSMINT_CLIENT_API_KEY=ck_staging_...
# Server API key. Only Agent Checkouts use it, with x-crossmint-user-id.
CROSSMINT_SERVER_API_KEY=sk_staging_...

# --- Agent Commerce Sample App -----------------------------------------------
# Public URL of this deployment. Builds the approval links agents show users.
AGENT_COMMERCE_WEB_BASE_URL=http://localhost:3000
# RSA private JWK (JSON or base64url JSON) for the encrypted-card fallback rail. Optional.
AGENT_COMMERCE_ENCRYPTED_CARD_PRIVATE_KEY=
# Postgres URL for agent card requests and chat history. Omit to use the in-memory store.
DATABASE_URL=
# Vercel Blob token for chat attachments. Chat half only.
BLOB_READ_WRITE_TOKEN=

# --- Stytch (user auth) ------------------------------------------------------
# Project id. Starts with project-test- or project-live-.
STYTCH_PROJECT_ID=project-test-...
# Project secret. Server only. Needed to list and revoke sessions and to refresh agent JWTs.
STYTCH_SECRET=secret-test-...
# Public token for the browser SDK. Must be from the same environment (test/live) as the project id.
NEXT_PUBLIC_STYTCH_PUBLIC_TOKEN=public-token-test-...
# Session length requested at login, in minutes. Default 10080 (7 days). Keep it at or below
# the maximum in Stytch → SDK Configuration → Sessions. Agents stay logged in this long.
NEXT_PUBLIC_STYTCH_SESSION_MINUTES=10080
# Optional. Only if you use a custom Stytch domain. Defaults to https://test.stytch.com/v1/public/<project id>.
# In Stytch → Connected Apps → Settings, set the Authorization URL to <AGENT_COMMERCE_WEB_BASE_URL>/oauth/authorize.
STYTCH_PROJECT_DOMAIN=
# Connected Apps client id the agent-commerce CLI uses for OAuth login.
STYTCH_CLI_CLIENT_ID=connected-app-...
# Connected Apps client id MCP hosts use for OAuth login.
STYTCH_MCP_CLIENT_ID=connected-app-...

# --- Chat (optional) ---------------------------------------------------------
# Enables the agent chat inside /app and the /api/chat route. Set one of these.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Anthropic model id the chat uses. Default claude-sonnet-5.
# Default is claude-sonnet-5 for Anthropic, gpt-5.4 for OpenAI.
CHAT_MODEL=
