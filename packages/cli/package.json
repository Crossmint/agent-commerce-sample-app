{
  "name": "goat",
  "version": "2.0.0-alpha.0",
  "description": "GOAT CLI: let an agent request a bounded agent card, reveal it, or run a checkout, with the user's approval.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "goat": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@goat-wallet/auth": "workspace:*",
    "@goat-wallet/core": "workspace:*",
    "commander": "^15.0.0",
    "open": "^11.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@goat-wallet/tsconfig": "workspace:*",
    "@types/node": "^22",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  }
}
