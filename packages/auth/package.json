{
  "name": "@agent-commerce/auth",
  "version": "0.1.0",
  "private": true,
  "description": "Bring-your-own-auth for Agent Commerce: one UserAuth interface, Stytch and generic JWKS adapters, OAuth PKCE helpers for agents.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./stytch": { "types": "./dist/stytch.d.ts", "import": "./dist/stytch.js" },
    "./jwks": { "types": "./dist/generic-jwks.d.ts", "import": "./dist/generic-jwks.js" },
    "./oauth": { "types": "./dist/oauth.d.ts", "import": "./dist/oauth.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "jose": "^6.2.0"
  },
  "devDependencies": {
    "@agent-commerce/tsconfig": "workspace:*",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  }
}
