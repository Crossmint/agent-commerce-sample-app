{
  "name": "goat-monorepo",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "changeset": "changeset",
    "release": "turbo run build && changeset publish",
    "plugin:validate": "node scripts/validate-cursor-plugin.mjs && claude plugin validate plugins/claude && claude plugin validate .claude-plugin/marketplace.json",
    "plugin:sync": "cp skills/goat/SKILL.md plugins/cursor/skills/goat/SKILL.md && cp skills/goat/SKILL.md plugins/claude/skills/goat/SKILL.md"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "prettier": "^3.6.0",
    "turbo": "^2.10.0",
    "typescript": "^5.9.0"
  },
  "pnpm": {
    "overrides": {
      "axios": "^1.20.0"
    }
  }
}
